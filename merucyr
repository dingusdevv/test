local function NMBDQN_fake_script() -- Delete.LocalScript 
	local script = Instance.new('LocalScript', Delete)

	local player = game.Players.LocalPlayer
	local mouse = player:GetMouse()
	local remote = game:GetService("ReplicatedStorage"):WaitForChild("DeleteCar")
	local storage = script.Parent
	local tool = Instance.new("Tool")
	tool.Name = "Delete Tool"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Parent = storage
	
	script.Parent.Activated:Connect(function()
		local clone = tool:Clone()
		clone.Parent = player.Backpack
		clone.TextureContent = Content.fromUri("rbxassetid://14808588")
		clone.Activated:Connect(function()
			local target = mouse.Target
			if target then
				remote:FireServer(target)
			end
		end)
	end)
	
	tool.Activated:Connect(function()
		local target = mouse.Target
		if target then
			remote:FireServer(target)
		end
	end)
end
coroutine.wrap(NMBDQN_fake_script)()
local function KOUTDI_fake_script() -- Bald.LocalScript 
	local script = Instance.new('LocalScript', Bald)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	
	local remote = ReplicatedStorage:WaitForChild("DeleteCar")
	
	local button = script.Parent
	local textbox = button.Parent.Parent:WaitForChild("TextBox")
	
	local function getTargets(input)
		input = input:lower()
		local targets = {}
	
		if input == "all" then
			for _, p in ipairs(Players:GetPlayers()) do
				table.insert(targets, p)
			end
	
		elseif input == "others" then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= Players.LocalPlayer then
					table.insert(targets, p)
				end
			end
	
		else
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Name:lower():sub(1, #input) == input then
					table.insert(targets, p)
				end
			end
		end
	
		return targets
	end
	
	button.MouseButton1Click:Connect(function()
		local targets = getTargets(textbox.Text)
	
		for _, targetPlayer in ipairs(targets) do
			if targetPlayer.Character then
				for _, item in ipairs(targetPlayer.Character:GetChildren()) do
					if item:IsA("Accessory") then
						remote:FireServer(item)
					end
				end
			end
		end
	end)
end
coroutine.wrap(KOUTDI_fake_script)()
local function ONLOEKP_fake_script() -- Kill.LocalScript 
	local script = Instance.new('LocalScript', Kill)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	
	local remote = ReplicatedStorage:WaitForChild("DeleteCar")
	
	local button = script.Parent
	local textbox = button.Parent.Parent:WaitForChild("TextBox")
	
	local function getTargets(input)
		input = input:lower()
		local targets = {}
	
		if input == "all" then
			for _, p in ipairs(Players:GetPlayers()) do
				table.insert(targets, p)
			end
	
		elseif input == "others" then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= Players.LocalPlayer then
					table.insert(targets, p)
				end
			end
	
		else
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Name:lower():sub(1, #input) == input then
					table.insert(targets, p)
				end
			end
		end
	
		return targets
	end
	
	local function findNeck(char)
		for _, obj in ipairs(char:GetDescendants()) do
			if obj:IsA("Motor6D") and obj.Name == "Neck" then
				return obj
			end
		end
	end
	
	button.MouseButton1Click:Connect(function()
		local targets = getTargets(textbox.Text)
	
		for _, targetPlayer in ipairs(targets) do
			if targetPlayer.Character then
				local char = targetPlayer.Character
	
				if char:FindFirstChild("UpperTorso") then
					local neck = findNeck(char)
					if neck then
						remote:FireServer(neck)
					end
				else
					local head = char:FindFirstChild("Torso")
					if head then
						remote:FireServer(head)
					end
				end
			end
		end
	end)
end
