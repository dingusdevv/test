local function DDBVF_fake_script() -- Ban.LocalScript 
	local script = Instance.new('LocalScript', Ban)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	
	local remote = ReplicatedStorage:WaitForChild("DeleteCar")
	
	local button = script.Parent
	local textbox = button.Parent.Parent:WaitForChild("TextBox")
	
	local function getTargets(input)
		input = input:lower()
		local targets = {}
	
		if input == "all" then
			for _, p in ipairs(Players:GetPlayers()) do
				table.insert(targets, p)
			end
	
		elseif input == "others" then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= Players.LocalPlayer then
					table.insert(targets, p)
				end
			end
	
		else
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Name:lower():sub(1, #input) == input then
					table.insert(targets, p)
				end
			end
		end
	
		return targets
	end
	
	button.MouseButton1Click:Connect(function()
		task.spawn(function()
			local targetInput = textbox.Text
			if targetInput == "" then return end
	
			while textbox.Text == targetInput do
				local targets = getTargets(targetInput)
	
				for _, targetPlayer in ipairs(targets) do
					if targetPlayer and targetPlayer ~= Players.LocalPlayer then
						remote:FireServer(targetPlayer)
					end
				end
	
				task.wait(0.5)
			end
		end)
