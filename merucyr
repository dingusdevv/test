local function DOEU_fake_script() -- ws.LocalScript 
	local script = Instance.new('LocalScript', ws)

	local player = game.Players.LocalPlayer
	local mouse = player:GetMouse()
	local remote = game:GetService("ReplicatedStorage"):WaitForChild("DeleteCar")
	
	local button = script.Parent
	
	local function isInsideIgnored(instance)
		local current = instance
		while current do
			if current:IsA("Model") or current:IsA("SpawnLocation") then
				return true
			end
			current = current.Parent
		end
		return false
	end
	
	button.Activated:Connect(function()
		local target = mouse.Target
		if target and not isInsideIgnored(target) then
			remote:FireServer(target)
		end
	end)
end
coroutine.wrap(DOEU_fake_script)()
