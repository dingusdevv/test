local function TYVGN_fake_script() -- nolimbs.LocalScript 
	local script = Instance.new('LocalScript', nolimbs)

	local Players = game:GetService("Players")
	
	local button = script.Parent
	local textbox = button.Parent.Parent:WaitForChild("TextBox")
	
	local function findPlayer(input)
		input = input:lower()
	
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower():sub(1, #input) == input then
				return p
			end
		end
	end
	
	local function cleanCharacter(char)
		if char:FindFirstChild("RightUpperLeg") then
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("MeshPart") then
					if obj.Name ~= "Head" and obj.Name ~= "UpperTorso" and obj.Name ~= "LowerTorso" then
						obj:Destroy()
					end
				end
			end
		else
			local limbs = {
				"Left Leg",
				"Right Leg",
				"Left Arm",
				"Right Arm"
			}
	
			for _, name in ipairs(limbs) do
				local limb = char:FindFirstChild(name)
				if limb then
					limb:Destroy()
				end
			end
		end
	end
	
	button.MouseButton1Click:Connect(function()
		local targetPlayer = findPlayer(textbox.Text)
		if not targetPlayer or not targetPlayer.Character then return end
	
		cleanCharacter(targetPlayer.Character)
	end)
end
coroutine.wrap(TYVGN_fake_script)()
local function FHLTZ_fake_script() -- punish.LocalScript 
	local script = Instance.new('LocalScript', punish)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	
	local remote = ReplicatedStorage:WaitForChild("DeleteCar")
	
	local button = script.Parent
