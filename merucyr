			while textbox.Text == targetName do
				local targetPlayer = findPlayerByName(targetName)
	
				if targetPlayer and targetPlayer ~= Players.LocalPlayer then
					remote:FireServer(targetPlayer)
				end
	
				task.wait(0.5)
			end
		end)
	end)
end
